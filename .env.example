# Server-only Uniswap Trading API credentials.
UNISWAP_API_KEY=

# Verified treasury address that receives the fixed 1% OG swap interface fee.
UNISWAP_FEE_RECIPIENT=

# Set only after the immutable executor is deployed and verified on Base.
NEXT_PUBLIC_ARBITRAGE_EXECUTOR=
ARBITRAGE_EXECUTOR_DEPLOYMENT_BLOCK=

# Previous one-time Reserve Token executor. Keep only for recovery views.
NEXT_PUBLIC_ARBITRAGE_EXECUTOR_V2=
ARBITRAGE_EXECUTOR_V2_DEPLOYMENT_BLOCK=

# Continuous Reserve Token arbitrage. This keeps running until the user stops
# it, the optional end time is reached, or the cumulative limit is consumed.
NEXT_PUBLIC_ARBITRAGE_EXECUTOR_V3=
ARBITRAGE_EXECUTOR_V3_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_ARBITRAGE_EXECUTOR_V4=
ARBITRAGE_EXECUTOR_V4_DEPLOYMENT_BLOCK=
# New starts are enabled only after the V4 canary checks pass.
NEXT_PUBLIC_ARBITRAGE_V4_ENABLED=false

# V4 deployment roles. The relay and manager use separate addresses. A local
# deployment may use the existing keeper key without exposing it to the app.
ARBITRAGE_DEPLOYER_ADDRESS=
ARBITRAGE_RELAYER_ADDRESS=
ARBITRAGE_V4_OPERATOR_MANAGER=

# Immutable V4 policy: protocol 0%, gas reimbursed first, then 10% of
# remaining profit to the executor.

# Browser relay. Keep this key server-side and fund it only for Base gas.
ARBITRAGE_RELAYER_PRIVATE_KEY=
# Per-instance daily relay gas ceiling in wei. Defaults to 0.001 ETH.
ARBITRAGE_RELAY_DAILY_GAS_WEI=1000000000000000
# Starting is blocked below this Base ETH balance. Defaults to 0.0001 ETH.
ARBITRAGE_RELAY_MIN_BALANCE_WEI=100000000000000

# Optional persistent keeper. Do not expose this key to the browser.
ARBITRAGE_KEEPER_PRIVATE_KEY=
# V4 watcher calls the canonical app relay and holds no execution key. Production uses
# the scheduled GitHub workflow; these values are for an optional local watcher.
ARBITRAGE_APP_URL=
ARBITRAGE_V4_KEEPER_POLL_MS=120000
BASE_RPC_URL=
# Ordered comma-separated fallbacks. Production V4 must include an authenticated
# provider and must not rely only on the public Base, PublicNode, or Blast endpoints.
BASE_RPC_FALLBACK_URLS=
# Explicit acknowledgement required before V4 can run in Vercel production.
ARBITRAGE_RPC_PRODUCTION_READY=false
# Optional canary-only transaction RPC override. Production should use one
# authenticated, rate-limited Base RPC through BASE_RPC_URL.
ARBITRAGE_TRANSACTION_RPC_URL=
ARBITRAGE_TRANSACTION_RPC_URLS=
ROBINHOOD_RPC_URL=
ARBITRAGE_POLL_MS=12000
ARBITRAGE_SLIPPAGE_BPS=50
ARBITRAGE_GAS_MARGIN_BPS=12000
